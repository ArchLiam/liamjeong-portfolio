{
    "name": "liamjeong-portfolio",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Personal portfolio of Liam (LJ) Jeong, Salesforce Architect. LWC OSS + LWR + SLDS, static build on Vercel.",
    "author": "Liam (LJ) Jeong",
    "repository": "github:ArchLiam/liamjeong-portfolio",
    "scripts": {
        "dev": "lwr dev --mode prod-compat",
        "build": "lwr build --mode prod-compat --clean",
        "postbuild": "node scripts/postbuild.js",
        "clean": "rimraf __lwr_cache__ site",
        "preview": "npx --yes serve site",
        "lint": "eslint .",
        "test": "jest",
        "test:a11y": "node scripts/a11y-check.js",
        "test:watch": "jest --watch",
        "format": "prettier --write \"**/*.{css,html,js,json,md,yml}\"",
        "format:check": "prettier --check \"**/*.{css,html,js,json,md,yml}\""
    },
    "dependencies": {
        "@salesforce-ux/design-system": "^2.24.0",
        "gsap": "^3.13.0",
        "lwc": "^9.5.1",
        "lwr": "^0.21.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@lwc/eslint-plugin-lwc": "^3.5.0",
        "@lwc/jest-preset": "^19.1.2",
        "@sa11y/jest": "8.0.27",
        "@salesforce/eslint-config-lwc": "^4.1.2",
        "@salesforce/eslint-plugin-lightning": "^2.0.0",
        "axe-core": "^4.14.0",
        "eslint": "^9.39.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.12.1",
        "globals": "^17.13.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "prettier": "^3.8.1",
        "puppeteer-core": "^25.14.0",
        "rimraf": "^6.1.3"
    },
    "engines": {
        "node": "22.x"
    }
}
